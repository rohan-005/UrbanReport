# Environment variables configuration example

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4001

# Downstream Microservices (Internal / Private Ports)
USERS_SERVICE_URL=http://localhost:5001
COMPLAINTS_SERVICE_URL=http://localhost:5002
MEDIA_SERVICE_URL=http://localhost:5003
MAPS_SERVICE_URL=http://localhost:5004
NOTIFICATIONS_SERVICE_URL=http://localhost:5005
GATEWAY_PORT=4001

# Authentication & Provider Secrets
JWT_SECRET=urbanreports_super_secret_jwt_key_2026
ADMIN_ID=admin@urbanreports.gov.in
ADMIN_PASSWORD=change_me

# Database & External Services
DATABASE_URL=postgresql://neondb_owner:password@ep-example.neon.tech/urbanreports?sslmode=require
MONGODB_URI=mongodb+srv://urbanreports_db:password@cluster.mongodb.net/urbanreports
MAPTILER_API_KEY=maptiler_api_key_placeholder
# Duplicate Detection & Search Configuration
DUPLICATE_SEARCH_RADIUS_METERS=250
DUPLICATE_MAX_CANDIDATES=10

# Notification Worker & SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=urbanreports_smtp_user
SMTP_PASSWORD=urbanreports_smtp_password
SMTP_FROM=no-reply@urbanreports.gov.in
EMAIL_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_NOTIFICATION_STREAM=urbanreports.notifications
NOTIFICATIONS_SERVICE_URL=http://localhost:3006
